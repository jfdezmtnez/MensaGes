<% content_for :title, "Companies" %>

<div class="w-full">
  <% if notice.present? %>
    <p class="py-2 px-3 bg-green-50 mb-5 text-green-500 font-medium rounded-md inline-block" id="notice"><%= notice %></p>
  <% end %>

  <div class="flex justify-between items-center">
    <h1 class="font-bold text-4xl">Companies</h1>
    <%= render RubyUI::Button.new(variant: :primary, options:{label: "New", href: new_company_path}) %>
  </div>

  <div id="companies" class="min-w-full divide-y divide-gray-200 space-y-5">
    <% if @companies.any? %>
      <% @companies.each do |company| %>
        <div class="flex justify-between items-center">
          <%= render company %>
          <div class="space-x-2">
            <%= render RubyUI::Button.new(variant: :link, options:{label: "Show", href: company_path(company)}) %>
            <%= render RubyUI::Button.new(variant: :secondary, options:{label: "Edit", href: edit_company_path(company)}) %>
            <div class="inline-block">
              <%= button_to "Destroy", company, method: :delete, class: "rounded-md px-3.5 py-2.5 text-white bg-red-600 hover:bg-red-500 font-medium cursor-pointer", data: { turbo_confirm: "Are you sure?" } %>
              <%= render RubyUI::Button.new(variant: :danger, options:{label: "Delete", href: destroy_method(company)}) %>
            </div>
          </div>
        </div>
      <% end %>
    <% else %>
      <p class="text-center my-10">No companies found.</p>
    <% end %>
  </div>
</div>
